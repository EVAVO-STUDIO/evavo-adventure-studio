{
  "name": "evavo-adventure-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=24.18.0 <25",
    "pnpm": ">=11.17.0 <12"
  },
  "scripts": {
    "build": "pnpm run build:types && pnpm run build:player && pnpm run build:studio",
    "build:types": "tsc -b",
    "build:player": "pnpm --filter @evavo/adventure-player build",
    "build:studio": "pnpm --filter @evavo/adventure-studio-app build",
    "build:cli": "pnpm --filter @evavo/adventure-cli build",
    "clean": "tsc -b --clean",
    "dev:player": "pnpm --filter @evavo/adventure-player dev",
    "dev:studio": "pnpm --filter @evavo/adventure-studio-app dev",
    "cli": "node tools/cli/dist/src/index.js",
    "export:night-shift-production": "pnpm run build:types && node scripts/export-night-shift-production.mjs",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "check:toolchain": "node scripts/verify-toolchain-version.mjs",
    "release:check": "node scripts/check-ci-release-readiness.mjs --full",
    "check:full-game-grammar": "vitest run packages/adventure-design/tests/full-game-capabilities.test.ts packages/adventure-design/tests/full-game-reference-policy.test.ts packages/adventure-design/tests/scene-archetypes.test.ts packages/adventure-design/tests/full-game-upgrade-plan.test.ts packages/adventure-design/tests/investigation-kernel.test.ts packages/adventure-design/tests/investigation-analysis.test.ts packages/runtime-bundle/tests/investigation-runtime.test.ts packages/runtime-bundle/tests/investigation-bindings.test.ts packages/compiler/tests/with-investigation.test.ts packages/scene-runtime/tests/investigation-runtime.test.ts packages/runtime-controller/tests/investigation-bindings-runtime.test.ts packages/runtime-controller/tests/investigation-controller.test.ts packages/save-game/tests/investigation-compatibility.test.ts packages/interaction/tests/sentence.test.ts packages/interaction/tests/item-combinations.test.ts packages/interaction/tests/sentence-execution.test.ts packages/runtime-bundle/tests/item-combinations.test.ts packages/save-game/tests/item-combination-compatibility.test.ts packages/save-game/tests/sentence-compatibility.test.ts packages/runtime-controller/tests/sentence-controller.test.ts packages/scene-runtime/tests/multi-protagonist.test.ts packages/runtime-bundle/tests/multi-protagonist.test.ts packages/save-game/tests/multi-protagonist-compatibility.test.ts packages/runtime-controller/tests/multi-protagonist-projection.test.ts packages/runtime-controller/tests/multi-protagonist-actor.test.ts packages/runtime-controller/tests/multi-protagonist-controller.test.ts packages/runtime-bundle/tests/room-scripts.test.ts packages/compiler/tests/with-room-scripts.test.ts packages/scene-runtime/tests/room-scripts.test.ts packages/save-game/tests/room-script-compatibility.test.ts packages/runtime-controller/tests/room-script-controller.test.ts packages/runtime-controller/tests/profiled-camera-scrolling-stress.test.ts packages/scene-runtime/tests/elevation-frame.test.ts packages/scene-instances/tests/elevation-navigation.test.ts",
    "check:night-shift-proof": "vitest run apps/studio/tests/night-shift-gameplay-proof.test.ts apps/studio/tests/night-shift-complete-proof.test.ts apps/studio/tests/night-shift-full-path.test.ts apps/studio/tests/night-shift-lifecycle.test.ts apps/studio/tests/night-shift-runtime-contracts.test.ts apps/studio/tests/night-shift-demo-readiness.test.ts apps/studio/tests/night-shift-animation-contract.test.ts apps/studio/tests/night-shift-ui-contracts.test.ts apps/studio/tests/night-shift-production-assets.test.ts apps/studio/tests/night-shift-production-waves.test.ts apps/studio/tests/night-shift-production-progress.test.ts apps/studio/tests/night-shift-station-slice-readiness.test.ts apps/studio/tests/night-shift-runtime-index-requirements.test.ts apps/studio/tests/night-shift-runtime-index-bindings.test.ts apps/studio/tests/night-shift-runtime-index-build-plan.test.ts apps/studio/tests/night-shift-runtime-source.test.ts apps/studio/tests/night-shift-production-manifest.test.ts apps/studio/tests/night-shift-station-production-packet.test.ts apps/studio/tests/night-shift-station-composition-guide.test.ts apps/studio/tests/night-shift-station-export.test.ts apps/studio/tests/night-shift-station-media-preflight.test.ts apps/studio/tests/night-shift-station-media-acceptance.test.ts apps/studio/tests/night-shift-scene-palette-intake.test.ts apps/studio/tests/night-shift-art-master-intake.test.ts apps/studio/tests/night-shift-generated-art-intake.test.ts apps/studio/tests/night-shift-audio-master-intake.test.ts apps/studio/tests/night-shift-runtime-source-export.test.ts apps/studio/tests/night-shift-foundation-generated.test.ts apps/studio/tests/night-shift-foundation-icon-outputs.test.ts apps/studio/tests/night-shift-font-generated.test.ts apps/studio/tests/night-shift-font-indexed-output.test.ts apps/studio/tests/night-shift-foundation-preflight.test.ts apps/studio/tests/night-shift-foundation-acceptance.test.ts apps/studio/tests/night-shift-officer-master-contract.test.ts apps/studio/tests/night-shift-officer-master-intake.test.ts apps/studio/tests/night-shift-officer-review-template.test.ts apps/studio/tests/night-shift-officer-art-brief.test.ts apps/studio/tests/night-shift-foundation-export.test.ts",
    "source:check": "node scripts/check-ci-release-readiness.mjs --source && pnpm run check:toolchain && node scripts/validate-red-ledger-runtime.mjs && node scripts/validate-red-ledger-lifecycle.mjs && node scripts/validate-red-ledger-front-end.mjs && pnpm run check:full-game-grammar && pnpm run check:night-shift-proof",
    "check:editor-expansion": "pnpm run release:check && node scripts/run-editor-expansion-check.mjs",
    "check": "pnpm run release:check && pnpm run check:toolchain && biome check . && tsc -b --pretty false && vitest run && pnpm run build:player && pnpm run build:studio",
    "check:ci": "pnpm run release:check && pnpm run check:toolchain && biome ci . && tsc -b --pretty false && vitest run && pnpm run build:player && pnpm run build:studio"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.5",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  }
}
