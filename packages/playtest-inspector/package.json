{
  "name": "@evavo/adventure-playtest-inspector",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    },
    "./canonical-diff": {
      "types": "./dist/src/canonical-diff.d.ts",
      "import": "./dist/src/canonical-diff.js"
    },
    "./replay-execution": {
      "types": "./dist/src/replay-execution.d.ts",
      "import": "./dist/src/replay-execution.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b --pretty false"
  },
  "dependencies": {
    "@evavo/adventure-project-schema": "workspace:*",
    "@evavo/adventure-replay": "workspace:*",
    "@evavo/adventure-runtime-bundle": "workspace:*",
    "@evavo/adventure-runtime-controller": "workspace:*",
    "@evavo/adventure-save-game": "workspace:*"
