{
  "name": "@evavo/adventure-runtime-bundle",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    },
    "./audio-validation": {
      "types": "./dist/src/audio-validation.d.ts",
      "import": "./dist/src/audio-validation.js"
    },
    "./font-validation": {
      "types": "./dist/src/font-validation.d.ts",
      "import": "./dist/src/font-validation.js"
    },
    "./localisation": {
      "types": "./dist/src/localisation.d.ts",
      "import": "./dist/src/localisation.js"
    },
    "./ui-validation": {
      "types": "./dist/src/ui-validation.d.ts",
      "import": "./dist/src/ui-validation.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b --pretty false"
  },
  "dependencies": {
    "@evavo/adventure-audio": "workspace:*",
    "@evavo/adventure-asset-contract": "workspace:*",
    "@evavo/adventure-bitmap-font": "workspace:*",
    "@evavo/adventure-project-schema": "workspace:*",
    "@evavo/adventure-scene-instances": "workspace:*",
    "@evavo/adventure-ui-skin": "workspace:*",
    "zod": "catalog:"
  }
}
