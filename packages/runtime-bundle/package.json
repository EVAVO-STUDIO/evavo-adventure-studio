    "./font-validation": { "types": "./dist/src/font-validation.d.ts", "import": "./dist/src/font-validation.js" },
    "./localisation": { "types": "./dist/src/localisation.d.ts", "import": "./dist/src/localisation.js" },
    "./multi-protagonist-bindings": { "types": "./dist/src/multi-protagonist-bindings.d.ts", "import": "./dist/src/multi-protagonist-bindings.js" },
    "./quick-response": { "types": "./dist/src/quick-response.d.ts", "import": "./dist/src/quick-response.js" },
    "./route-topology": { "types": "./dist/src/route-topology.d.ts", "import": "./dist/src/route-topology.js" },
